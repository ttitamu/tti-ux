{
  "name": "@tti/tti-ux-elements",
  "version": "4.0.0",
  "description": "TUX Web Components \u2014 framework-neutral Custom Elements with bundled design tokens.",
  "type": "module",
  "main": "./dist/tux-elements.js",
  "module": "./dist/tux-elements.js",
  "types": "./dist/tux-elements.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tux-elements.d.ts",
      "import": "./dist/tux-elements.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tux-tokens.css": "./dist/tux-tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://code.tti.tamu.edu/api/packages/tti/npm/"
  },
  "scripts": {
    "build": "node ../../scripts/build-elements.mjs",
    "prepack": "npm run build"
  }
}
