{
  "name": "@tti/tti-ux-react",
  "version": "3.7.2",
  "description": "TUX for React — standalone component ports and design tokens of the TTI design system (zero Vue/Nuxt dependencies).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tux-tokens.css": "./dist/tux-tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://code.tti.tamu.edu/api/packages/tti/npm/"
  },
  "repository": {
    "type": "git",
    "url": "https://code.tti.tamu.edu/tti/tti-ux.git",
    "directory": "packages/react"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "node ./scripts/copy-assets.mjs && tsc -p tsconfig.build.json && node ./scripts/copy-assets.mjs",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
