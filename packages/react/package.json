    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
