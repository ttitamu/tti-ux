{
  "name": "@tti/tti-ux-diagrams",
  "version": "3.12.0",
  "description": "Mermaid diagrams-as-code integration and institutional styling for the TTI design system (TUX).",
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./nuxt.config.ts": "./nuxt.config.ts",
    "./runtime/tuxArchitectureMap": {
      "types": "./runtime/tuxArchitectureMap.d.mts",
      "import": "./runtime/tuxArchitectureMap.mjs",
      "default": "./runtime/tuxArchitectureMap.mjs"
    },
    "./runtime/tuxArchitectureMap.mjs": {
      "types": "./runtime/tuxArchitectureMap.d.mts",
      "default": "./runtime/tuxArchitectureMap.mjs"
    },
    "./runtime/tuxArchitectureMapSample": {
      "types": "./runtime/tuxArchitectureMapSample.d.mts",
      "import": "./runtime/tuxArchitectureMapSample.mjs",
      "default": "./runtime/tuxArchitectureMapSample.mjs"
    },
    "./runtime/tuxArchitectureMapSample.mjs": {
      "types": "./runtime/tuxArchitectureMapSample.d.mts",
      "default": "./runtime/tuxArchitectureMapSample.mjs"
    },
    "./app/composables/*.ts": "./app/composables/*.ts",
    "./app/composables/*": "./app/composables/*.ts",
    "./app/utils/*.ts": "./app/utils/*.ts",
    "./app/utils/*": "./app/utils/*.ts",
    "./*": "./*"
  },
  "files": [
    "app",
    "runtime",
    "api",
    "tests/fixtures/map-conformance.json",
    "nuxt.config.ts",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://code.tti.tamu.edu/api/packages/tti/npm/"
  },
  "repository": {
    "type": "git",
    "url": "https://code.tti.tamu.edu/tti/tti-ux.git",
    "directory": "packages/diagrams"
  },
  "license": "Apache-2.0",
  "scripts": {
    "test": "node scripts/build-map-runtime.mjs --check && node scripts/build-map-api.mjs --check && vitest run",
    "build:runtime": "node scripts/build-map-runtime.mjs",
    "check:runtime": "node scripts/build-map-runtime.mjs --check",
    "build:api": "node scripts/build-map-api.mjs",
    "check:api": "node scripts/build-map-api.mjs --check",
    "gen:conformance": "node scripts/generate-map-conformance.ts",
    "check:conformance": "node scripts/generate-map-conformance.ts --check",
    "bench:map": "node scripts/bench-map.mjs"
  },
  "peerDependencies": {
    "@tti/tti-ux": "^3.0.0"
  },
  "dependencies": {
    "mermaid": "^12.2.0"
  }
}
