// TUX theme tables — paste into Power BI Desktop.
// Generated by scripts/build-pbir-components.mjs; do not hand-edit.
//
// 1. Modeling > New table, for each of the two table expressions.
// 2. Modeling > New measure, once per measure below, with
//    TuxThemeColors selected as the home table.
// 3. Put a slicer on ThemeMode[Mode] and sync it across pages.

// ---- Tables ----

ThemeMode = DATATABLE("Mode", STRING, "SortOrder", INTEGER, {{"Dark", 1}, {"Light", 2}})

TuxThemeColors = ROW("Placeholder", 1)

// ---- Measures ----

// Surface

PageBackground = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#0B0908", "#F5F5F5")

CardBackground = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#221F1F", "#FFFFFF")

SecondaryBackground = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#15100F", "#FFFFFF")

BorderColor = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#3D3A3A", "#E7E6E6")

// Text

TextPrimary = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#FAFAFA", "#221F1F")

TextSecondary = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#D1D2D4", "#424242")

TextMuted = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#B5B5B5", "#525252")

TextOnAccent = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#FFFFFF", "#FFFFFF")

// Accent

AccentPrimary = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#6BB4C0", "#5C0025")

AccentGold = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#DDAC37", "#DDAC37")

// Table

TableHeaderBg = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#221F1F", "#FFFFFF")

TableHeaderText = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#FAFAFA", "#221F1F")

TableRowBg = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#221F1F", "#FFFFFF")

TableAltRowBg = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#0B0908", "#F5F5F5")

TableRowText = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#FAFAFA", "#221F1F")

TableTotalBg = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#0B0908", "#F5F5F5")

TableGrid = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#2E2B2A", "#EFEEED")

// Chart

ChartGridline = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#2E2B2A", "#EFEEED")

ChartLabelText = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#D1D2D4", "#424242")

ChartBackground = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#221F1F", "#FFFFFF")

// Semantic

SemanticGood = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#ABCC8E", "#3D5328")

SemanticBad = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#F59292", "#A02828")

SemanticWarning = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#F5D98A", "#DDAC37")

SemanticNeutral = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#0B0908", "#F5F5F5")

// Shell

ShellHeaderBg = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#5C0025", "#5C0025")

ShellHeaderText = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#FFFFFF", "#FFFFFF")

ShellAccentRule = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#DDAC37", "#DDAC37")

// Tooltip

TooltipBackground = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#FAFAFA", "#221F1F")

TooltipTitle = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#221F1F", "#FFFFFF")

TooltipValue = IF(SELECTEDVALUE(ThemeMode[Mode], "Light") = "Dark", "#0B0908", "#F5F5F5")
