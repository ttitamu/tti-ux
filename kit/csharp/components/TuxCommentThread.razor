@*
 * TuxCommentThread.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<div class="tux-comment-thread">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string ModelValue { get; set; };
    [Parameter] public string Authors { get; set; };
    [Parameter] public string CurrentUser { get; set; };
    [Parameter] public bool HideResolved { get; set; } = true;
    [Parameter] public string Size { get; set; } = md;
}
