@*
 * TuxEntityPicker.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<div class="tux-entity-picker">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? ModelValue { get; set; }
    [Parameter] public string? Options { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Search by code, title, or owner…";
    [Parameter] public bool Clearable { get; set; } = true;
}
