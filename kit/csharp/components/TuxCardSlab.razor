@*
 * TuxCardSlab.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<section class="tux-card-slab">
    @ChildContent
</section>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Cards { get; set; };
    [Parameter] public string Columns { get; set; } = 3;
    [Parameter] public string Aspect { get; set; } = 4/5;
    [Parameter] public string Heading { get; set; } = "undefined";
    [Parameter] public string Eyebrow { get; set; } = "undefined";
    [Parameter] public bool Inset { get; set; } = false;
}
