@*
 * TuxAnnouncementBanner.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<div class="tux-announcement-banner">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string Tone { get; set; } = "info";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? Action { get; set; }
    [Parameter] public bool Dismissable { get; set; } = true;
}
