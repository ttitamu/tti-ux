@*
 * TuxAbstract.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<section class="tux-abstract">
    @ChildContent
</section>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Background { get; set; };
    [Parameter] public string Methods { get; set; };
    [Parameter] public string Results { get; set; };
    [Parameter] public string Conclusion { get; set; };
    [Parameter] public string Keywords { get; set; };
    [Parameter] public string Variant { get; set; } = "structured";
    [Parameter] public int Level { get; set; } = 4;
    [Parameter] public string PlainSummary { get; set; };
    [Parameter] public string PolicyTakeaways { get; set; };
    [Parameter] public string Doi { get; set; };
    [Parameter] public string ProjectNumber { get; set; };
    [Parameter] public string Citation { get; set; };
    [Parameter] public string Division { get; set; };
}
