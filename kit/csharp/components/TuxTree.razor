@*
 * TuxTree.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<ul class="tux-tree">
    @ChildContent
</ul>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Items { get; set; };
    [Parameter] public string DefaultExpanded { get; set; } = "undefined";
    [Parameter] public string StorageKey { get; set; } = "undefined";
    [Parameter] public bool ShowGuides { get; set; } = true;
    [Parameter] public string AriaLabel { get; set; } = "Tree";
}
