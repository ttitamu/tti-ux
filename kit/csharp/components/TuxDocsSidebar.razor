@*
 * TuxDocsSidebar.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<div class="tux-docs-sidebar">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Tree { get; set; };
    [Parameter] public string Title { get; set; } = "Docs";
    [Parameter] public bool Search { get; set; } = true;
    [Parameter] public string SearchPlaceholder { get; set; } = "Filter";
    [Parameter] public string StorageKey { get; set; } = tux-docs-sidebar;
    [Parameter] public bool ExclusiveTopLevel { get; set; } = false;
}
