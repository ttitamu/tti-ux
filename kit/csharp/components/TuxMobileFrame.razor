@*
 * TuxMobileFrame.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<figure class="tux-mobile-frame">
    @ChildContent
</figure>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Platform { get; set; } = "ios";
    [Parameter] public int Width { get; set; } = 280;
    [Parameter] public string Color { get; set; } = undefined;
    [Parameter] public bool StatusBar { get; set; } = true;
    [Parameter] public string Time { get; set; } = "9:41";
    [Parameter] public bool Notch { get; set; } = true;
    [Parameter] public bool HomeIndicator { get; set; } = true;
    [Parameter] public string NavStyle { get; set; } = "gesture";
    [Parameter] public string AriaLabel { get; set; } = "undefined";
}
