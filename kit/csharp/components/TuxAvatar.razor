@*
 * TuxAvatar.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<span class="tux-avatar">
    @ChildContent
</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Name { get; set; } = "undefined";
    [Parameter] public string Initials { get; set; } = "undefined";
    [Parameter] public string PhotoUrl { get; set; } = "undefined";
    [Parameter] public string Size { get; set; } = md;
    [Parameter] public string Dot { get; set; } = undefined;
    [Parameter] public bool Decorative { get; set; } = true;
    [Parameter] public string Alt { get; set; } = "undefined";
}
