@*
 * TuxSpectrumFacts.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<section class="tux-spectrum-facts">
    @ChildContent
</section>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Title { get; set; } = "QUICK";
    [Parameter] public string Subtitle { get; set; };
    [Parameter] public string Items { get; set; } = "()";
    [Parameter] public string Tone { get; set; } = dark;
    [Parameter] public bool ShowTopRibbon { get; set; } = true;
}
