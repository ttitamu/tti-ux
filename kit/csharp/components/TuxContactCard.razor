@*
 * TuxContactCard.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<article class="tux-contact-card">
    @ChildContent
</article>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Name { get; set; };
    [Parameter] public string Role { get; set; } = "undefined";
    [Parameter] public string Affiliation { get; set; } = "undefined";
    [Parameter] public string Credentials { get; set; } = "undefined";
    [Parameter] public string Image { get; set; } = "undefined";
    [Parameter] public string Initial { get; set; } = "undefined";
    [Parameter] public string Tone { get; set; } = maroon;
    [Parameter] public string Contacts { get; set; } = "()";
    [Parameter] public string Layout { get; set; } = vertical;
}
