@*
 * TuxFundingSource.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<div class="tux-funding-source">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Funder { get; set; }
    [Parameter] public string? Abbrev { get; set; }
    [Parameter] public string? Logo { get; set; }
    [Parameter] public string? Grant { get; set; }
    [Parameter] public string? To { get; set; }
    [Parameter] public string Size { get; set; } = "md";
    [Parameter] public string Layout { get; set; } = "inline";
}
