@*
 * TuxResultCount.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<div class="tux-result-count">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int Page { get; set; };
    [Parameter] public int PageSize { get; set; };
    [Parameter] public int Total { get; set; };
    [Parameter] public string Noun { get; set; } = "undefined";
    [Parameter] public string NounPlural { get; set; } = "undefined";
    [Parameter] public string PageSizeOptions { get; set; } = "undefined";
    [Parameter] public bool HideRange { get; set; } = false;
    [Parameter] public string PageSizeLabel { get; set; } = "per";
}
