@*
 * TuxProportionalInput.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<div class="tux-proportional-input">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? ModelValue { get; set; }
    [Parameter] public int TargetTotal { get; set; } = 100;
    [Parameter] public string Unit { get; set; } = "%";
    [Parameter] public int Decimals { get; set; } = 1;
    [Parameter] public int Step { get; set; } = 1;
    [Parameter] public string? Title { get; set; }
}
