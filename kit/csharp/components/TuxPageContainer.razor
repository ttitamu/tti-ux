@*
 * TuxPageContainer.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<div class="tux-page-container">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Width { get; set; } = "default";
    [Parameter] public bool Flush { get; set; } = false;
    [Parameter] public string As { get; set; } = "div";
}
