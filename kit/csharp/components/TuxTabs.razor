@*
 * TuxTabs.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<UTabs class="tux-tabs">
    @ChildContent
</UTabs>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Items { get; set; };
    [Parameter] public string ModelValue { get; set; } = undefined;
    [Parameter] public string Orientation { get; set; } = horizontal;
    [Parameter] public string Size { get; set; } = md;
    [Parameter] public string Variant { get; set; } = default;
}
