@*
 * TuxMetroInset.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<div class="tux-metro-inset">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Name { get; set; };
    [Parameter] public string HighwayLabel { get; set; };
    [Parameter] public int Height { get; set; } = 220;
    [Parameter] public string Palette { get; set; } = "maroon";
    [Parameter] public string Seed { get; set; };
    [Parameter] public int Cols { get; set; } = 8;
    [Parameter] public int Rows { get; set; } = 6;
}
