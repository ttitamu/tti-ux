@*
 * TuxIdentity.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<component class="tux-identity">
    @ChildContent
</component>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Name { get; set; };
    [Parameter] public string Superhead { get; set; } = null;
    [Parameter] public string Level { get; set; } = institution;
    [Parameter] public string Orientation { get; set; } = horizontal;
    [Parameter] public string Kind { get; set; } = lockup;
    [Parameter] public string Href { get; set; } = null;
    [Parameter] public int LogoSize { get; set; } = 0;
}
