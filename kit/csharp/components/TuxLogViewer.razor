@*
 * TuxLogViewer.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<div class="tux-log-viewer">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Title { get; set; } = "Operational Job & Telemetry Logs";
    [Parameter] public string? Lines { get; set; }
    [Parameter] public string InitialLevel { get; set; } = "all";
    [Parameter] public bool WrapLines { get; set; } = true;
    [Parameter] public bool ShowLineNumbers { get; set; } = true;
    [Parameter] public string MaxHeight { get; set; } = "24rem";
}
