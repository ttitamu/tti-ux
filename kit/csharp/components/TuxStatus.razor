@*
 * TuxStatus.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<span class="tux-status">
    @ChildContent
</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string State { get; set; };
    [Parameter] public string Kind { get; set; } = "chip";
    [Parameter] public bool Acked { get; set; } = false;
    [Parameter] public string Label { get; set; } = "undefined";
}
