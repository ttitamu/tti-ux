@*
 * TuxRemovableChip.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<span class="tux-removable-chip">
    @ChildContent
</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Icon { get; set; } = "undefined";
    [Parameter] public bool Removable { get; set; } = false;
    [Parameter] public string Size { get; set; } = md;
    [Parameter] public bool Selected { get; set; } = false;
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public string RemoveLabel { get; set; } = "undefined";
    [Parameter] public bool ClickToRemove { get; set; } = false;
}
