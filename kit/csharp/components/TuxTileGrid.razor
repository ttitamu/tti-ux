@*
 * TuxTileGrid.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<section class="tux-tile-grid">
    @ChildContent
</section>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Title { get; set; } = "Safety";
    [Parameter] public string Subtitle { get; set; };
    [Parameter] public string Tiles { get; set; } = "()";
    [Parameter] public string Columns { get; set; } = 3;
    [Parameter] public string Surface { get; set; } = eggshell;
}
