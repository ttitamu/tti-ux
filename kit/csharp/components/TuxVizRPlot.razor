@*
 * TuxVizRPlot.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<figure class="tux-viz-rplot">
    @ChildContent
</figure>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Src { get; set; };
    [Parameter] public string Kind { get; set; } = "image";
    [Parameter] public string Title { get; set; };
    [Parameter] public string Eyebrow { get; set; } = "undefined";
    [Parameter] public string Ratio { get; set; } = "16/10";
    [Parameter] public string Alt { get; set; };
    [Parameter] public string Src2x { get; set; } = "undefined";
    [Parameter] public string Source { get; set; } = "undefined";
    [Parameter] public string Level { get; set; } = 3;
}
