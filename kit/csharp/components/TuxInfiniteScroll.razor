@*
 * TuxInfiniteScroll.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<div class="tux-infinite-scroll">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int Loaded { get; set; };
    [Parameter] public int Total { get; set; };
    [Parameter] public bool Loading { get; set; } = false;
    [Parameter] public bool KeyboardFallback { get; set; } = false;
    [Parameter] public string RootMargin { get; set; } = "200px";
    [Parameter] public string Noun { get; set; } = "undefined";
    [Parameter] public string NounPlural { get; set; } = "undefined";
}
