<nav class="tux-link-slab">
    @ChildContent
</nav>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Links { get; set; };
    [Parameter] public string Tone { get; set; } = plain;
    [Parameter] public string AriaLabel { get; set; } = "Section";
}
