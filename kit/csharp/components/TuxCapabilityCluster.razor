@*
 * TuxCapabilityCluster.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<section class="tux-capability-cluster">
    @ChildContent
</section>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Title { get; set; };
    [Parameter] public string Kicker { get; set; };
    [Parameter] public string Subtitle { get; set; };
    [Parameter] public string Capabilities { get; set; };
    [Parameter] public int Columns { get; set; } = 3;
}
