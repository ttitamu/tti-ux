@*
 * TuxSiteNav.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<header class="tux-site-nav">
    @ChildContent
</header>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Identity { get; set; };
    [Parameter] public string PrimaryNav { get; set; } = "()";
    [Parameter] public string UtilityNav { get; set; } = "()";
    [Parameter] public bool Search { get; set; } = false;
    [Parameter] public bool Sticky { get; set; } = false;
    [Parameter] public string AriaLabel { get; set; } = "Primary";
}
