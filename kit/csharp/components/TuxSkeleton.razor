@*
 * TuxSkeleton.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<div class="tux-skeleton">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Kind { get; set; } = "primitive";
    [Parameter] public string Variant { get; set; } = "block";
    [Parameter] public string Width { get; set; } = "100%";
    [Parameter] public string Height { get; set; } = "undefined";
    [Parameter] public string Radius { get; set; } = "undefined";
    [Parameter] public int Count { get; set; } = 3;
    [Parameter] public string Animated { get; set; } = "shimmer";
    [Parameter] public string Label { get; set; } = "Loading…";
}
