@*
 * TuxPortalHeader.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<header class="tux-portal-header">
    @ChildContent
</header>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Mode { get; set; } = comm;
    [Parameter] public string AgencyName { get; set; } = "Texas";
    [Parameter] public string AgencyUrl { get; set; } = "https://tti.tamu.edu";
    [Parameter] public string HomeUrl { get; set; } = "/";
    [Parameter] public string PortalTitle { get; set; };
    [Parameter] public string PortalBadge { get; set; };
    [Parameter] public string PortalBadgeVariant { get; set; } = gold;
    [Parameter] public string UtilityLinks { get; set; } = "()";
    [Parameter] public bool ShowSearch { get; set; } = true;
    [Parameter] public bool ShowSpectrumRibbon { get; set; } = false;
    [Parameter] public string IntranetApps { get; set; } = "()";
}
