    [Parameter] public string? Doi { get; set; }
    [Parameter] public string? License { get; set; }
    [Parameter] public string? Funders { get; set; }
    [Parameter] public string? Published { get; set; }
    [Parameter] public string? Version { get; set; }
    [Parameter] public string? Type { get; set; }
    [Parameter] public string? Pages { get; set; }
    [Parameter] public string? Venue { get; set; }
}
