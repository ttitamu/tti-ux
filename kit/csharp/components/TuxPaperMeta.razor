@*
 * TuxPaperMeta.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<dl class="tux-paper-meta">
    @ChildContent
</dl>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Doi { get; set; } = "undefined";
    [Parameter] public string License { get; set; } = "undefined";
    [Parameter] public string Funders { get; set; } = "undefined";
    [Parameter] public string Published { get; set; } = "undefined";
    [Parameter] public string Version { get; set; } = "undefined";
    [Parameter] public string Type { get; set; } = "undefined";
    [Parameter] public string Pages { get; set; } = "undefined";
    [Parameter] public string Venue { get; set; } = "undefined";
}
