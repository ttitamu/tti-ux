@*
 * TuxSidebarBlock.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<section class="tux-sidebar-block">
    @ChildContent
</section>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Title { get; set; };
    [Parameter] public string Eyebrow { get; set; } = "undefined";
    [Parameter] public string Icon { get; set; } = "undefined";
    [Parameter] public string Variant { get; set; } = default;
}
