@*
 * TuxCodeBlock.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<figure class="tux-code-block">
    @ChildContent
</figure>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Code { get; set; };
    [Parameter] public string Lang { get; set; } = text;
    [Parameter] public string Filename { get; set; } = "undefined";
    [Parameter] public bool LineNumbers { get; set; } = false;
    [Parameter] public bool NoCopy { get; set; } = false;
    [Parameter] public bool NoDownload { get; set; } = false;
}
