@*
 * TuxAcknowledgments.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<section class="tux-acknowledgments">
    @ChildContent
</section>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Funding { get; set; }
    [Parameter] public string? Acknowledgments { get; set; }
    [Parameter] public string? Conflicts { get; set; }
    [Parameter] public string? Ethics { get; set; }
    [Parameter] public int Level { get; set; } = 4;
}
