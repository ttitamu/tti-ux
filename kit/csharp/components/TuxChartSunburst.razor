@*
 * TuxChartSunburst.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<div class="tux-chart-sunburst">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Data { get; set; };
    [Parameter] public int Size { get; set; } = 320;
    [Parameter] public string CenterLabel { get; set; } = "Total";
    [Parameter] public string FormatTotal { get; set; } = "undefined";
    [Parameter] public string FormatValue { get; set; } = "undefined";
    [Parameter] public bool ShowLegend { get; set; } = true;
    [Parameter] public string Palette { get; set; } = "undefined";
    [Parameter] public bool Tooltip { get; set; } = true;
}
