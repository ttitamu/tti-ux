@*
 * TuxStageBoard.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<div class="tux-stage-board">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Stages { get; set; }
    [Parameter] public string? Items { get; set; }
    [Parameter] public string MetricPrefix { get; set; } = "";
    [Parameter] public string MetricSuffix { get; set; } = "";
    [Parameter] public int Decimals { get; set; } = 0;
    [Parameter] public bool Movable { get; set; } = true;
}
