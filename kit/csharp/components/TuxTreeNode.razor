@*
 * TuxTreeNode.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<li class="tux-tree-node">
    @ChildContent
</li>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Node { get; set; };
    [Parameter] public int Depth { get; set; };
    [Parameter] public string SelectedId { get; set; };
    [Parameter] public string IsExpanded { get; set; };
    [Parameter] public bool ShowGuides { get; set; } = false;
}
