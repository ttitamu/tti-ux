@*
 * TuxMapLegend.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<div class="tux-map-legend">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? Entries { get; set; }
    [Parameter] public string Layout { get; set; } = "stacked";
    [Parameter] public string? Gradient { get; set; }
    [Parameter] public string? MinLabel { get; set; }
    [Parameter] public string? MaxLabel { get; set; }
    [Parameter] public string? Css { get; set; }
    [Parameter] public string? Stops { get; set; }
}
