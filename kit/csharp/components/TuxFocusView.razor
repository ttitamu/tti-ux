@*
 * TuxFocusView.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<div class="tux-focus-view">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Open { get; set; } = false;
    [Parameter] public string Title { get; set; };
    [Parameter] public string Eyebrow { get; set; };
    [Parameter] public bool DismissOnBackdropClick { get; set; } = true;
    [Parameter] public bool DismissOnEscape { get; set; } = true;
    [Parameter] public string BackLabel { get; set; } = "Close";
}
