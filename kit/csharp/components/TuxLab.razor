@*
 * TuxLab.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<article class="tux-lab">
    @ChildContent
</article>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Summary { get; set; }
    [Parameter] public string? Logo { get; set; }
    [Parameter] public int? ProjectsCount { get; set; }
    [Parameter] public int? PeopleCount { get; set; }
    [Parameter] public string? Location { get; set; }
    [Parameter] public string? Leaders { get; set; }
    [Parameter] public string? Focus { get; set; }
    [Parameter] public string? To { get; set; }
}
