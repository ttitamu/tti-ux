@*
 * TuxTestimonial.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<ul class="tux-testimonial">
    @ChildContent
</ul>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Items { get; set; };
    [Parameter] public string Layout { get; set; } = grid;
    [Parameter] public string Columns { get; set; } = 3;
    [Parameter] public string Variant { get; set; } = default;
}
