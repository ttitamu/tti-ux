@*
 * TuxSplashScreen.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<div class="tux-splash-screen">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Loaded { get; set; } = false;
    [Parameter] public string Status { get; set; } = "Loading…";
    [Parameter] public bool Hidden { get; set; } = false;
    [Parameter] public int FadeDelay { get; set; } = 300;
}
