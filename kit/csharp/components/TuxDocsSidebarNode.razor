@*
 * TuxDocsSidebarNode.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<li class="tux-docs-sidebar-node">
    @ChildContent
</li>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Section { get; set; };
    [Parameter] public string Path { get; set; };
    [Parameter] public string Query { get; set; };
    [Parameter] public string OpenMap { get; set; };
    [Parameter] public string IsOpen { get; set; };
    [Parameter] public string IsActive { get; set; };
    [Parameter] public string OnToggle { get; set; };
    [Parameter] public int Depth { get; set; };
}
