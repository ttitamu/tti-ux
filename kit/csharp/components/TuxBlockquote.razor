@*
 * TuxBlockquote.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<figure class="tux-blockquote">
    @ChildContent
</figure>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Quote { get; set; };
    [Parameter] public string Attribution { get; set; } = null;
    [Parameter] public string Role { get; set; } = null;
    [Parameter] public string Layout { get; set; } = centered;
    [Parameter] public string Variant { get; set; } = default;
}
