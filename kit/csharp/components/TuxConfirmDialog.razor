@*
 * TuxConfirmDialog.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<TuxModal class="tux-confirm-dialog">
    @ChildContent
</TuxModal>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Open { get; set; } = false;
    [Parameter] public string Title { get; set; };
    [Parameter] public string Eyebrow { get; set; } = "undefined";
    [Parameter] public string ConfirmLabel { get; set; } = "undefined";
    [Parameter] public string CancelLabel { get; set; } = "Cancel";
    [Parameter] public string Variant { get; set; } = destructive;
    [Parameter] public bool ConfirmDisabled { get; set; } = false;
    [Parameter] public bool Loading { get; set; } = false;
    [Parameter] public string Size { get; set; } = sm;
}
