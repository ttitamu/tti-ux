@*
 * TuxLinkList.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<div class="tux-link-list">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Groups { get; set; };
    [Parameter] public string Layout { get; set; } = columns;
    [Parameter] public string Columns { get; set; } = 3;
}
