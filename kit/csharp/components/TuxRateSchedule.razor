@*
 * TuxRateSchedule.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<section class="tux-rate-schedule">
    @ChildContent
</section>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Title { get; set; } = "Effective-Dated Rate Schedule";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Items { get; set; }
    [Parameter] public string CurrencySymbol { get; set; } = "$";
    [Parameter] public int SampleQuantity { get; set; } = 100;
    [Parameter] public bool Editable { get; set; } = true;
    [Parameter] public string StatusFilter { get; set; } = "all";
}
