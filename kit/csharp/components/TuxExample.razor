@*
 * TuxExample.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<div class="tux-example">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Vue { get; set; };
    [Parameter] public string React { get; set; };
    [Parameter] public string Wc { get; set; };
    [Parameter] public string Razor { get; set; };
    [Parameter] public string Python { get; set; };
    [Parameter] public string Php { get; set; };
    [Parameter] public string Swift { get; set; };
    [Parameter] public string Kotlin { get; set; };
    [Parameter] public string Source { get; set; };
    [Parameter] public string Css { get; set; };
    [Parameter] public string Powerbi { get; set; };
    [Parameter] public string Title { get; set; };
    [Parameter] public string PreviewPadding { get; set; } = "p-6";
}
