@*
 * TuxBranchNav.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<nav class="tux-branch-nav">
    @ChildContent
</nav>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int ModelValue { get; set; };
    [Parameter] public int Total { get; set; };
    [Parameter] public bool Loop { get; set; } = false;
    [Parameter] public bool HideSingleton { get; set; } = true;
    [Parameter] public string AriaLabel { get; set; } = "Response";
}
