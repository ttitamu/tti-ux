@*
 * TuxMcpEmbed.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<section class="tux-mcp-embed">
    @ChildContent
</section>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? AppName { get; set; }
    [Parameter] public string AppIcon { get; set; } = "lucide:plug";
    [Parameter] public string? AppIconUrl { get; set; }
    [Parameter] public string? Source { get; set; }
    [Parameter] public bool Loading { get; set; } = false;
    [Parameter] public bool Collapsible { get; set; } = true;
    [Parameter] public bool Expandable { get; set; } = true;
    [Parameter] public bool Closable { get; set; } = true;
    [Parameter] public bool Collapsed { get; set; } = false;
}
