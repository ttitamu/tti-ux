@*
 * TuxRichTextEditor.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<div class="tux-rich-text-editor">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string ModelValue { get; set; };
    [Parameter] public string Placeholder { get; set; } = "Start";
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public string MinHeight { get; set; } = "12rem";
    [Parameter] public string MaxHeight { get; set; } = "auto";
    [Parameter] public string Toolbar { get; set; } = ();
    [Parameter] public string HeadingLevels { get; set; } = ();
    [Parameter] public bool ShowCount { get; set; } = true;
    [Parameter] public bool Fullscreenable { get; set; } = true;
    [Parameter] public string AriaLabel { get; set; } = "Rich";
}
