@*
 * TuxSectionHeader.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<header class="tux-section-header">
    @ChildContent
</header>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int Level { get; set; } = 2;
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? SecondaryTitle { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Kicker { get; set; }
    [Parameter] public string Variant { get; set; } = "institutional";
    [Parameter] public string? Division { get; set; }
}
