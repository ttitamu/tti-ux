@*
 * TuxFeedback.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<section class="tux-feedback">
    @ChildContent
</section>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string PageId { get; set; };
    [Parameter] public string Title { get; set; } = "Was";
    [Parameter] public string Endpoint { get; set; } = "/api/feedback";
    [Parameter] public bool AllowDetails { get; set; } = true;
}
