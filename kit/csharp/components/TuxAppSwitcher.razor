@*
 * TuxAppSwitcher.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<div class="tux-app-switcher">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Apps { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Switch apps";
    [Parameter] public string Heading { get; set; } = "TTI Portals";
    [Parameter] public string? FooterText { get; set; }
    [Parameter] public string Presentation { get; set; } = "popover";
}
