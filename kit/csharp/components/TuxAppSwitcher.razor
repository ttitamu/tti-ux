@*
 * TuxAppSwitcher.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<UPopover class="tux-app-switcher">
    @ChildContent
</UPopover>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Apps { get; set; };
    [Parameter] public string AriaLabel { get; set; } = "Switch";
    [Parameter] public string Heading { get; set; } = "TTI";
    [Parameter] public string FooterText { get; set; } = "undefined";
    [Parameter] public string Presentation { get; set; } = popover;
}
