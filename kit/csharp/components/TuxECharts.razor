@*
 * TuxECharts.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<div class="tux-echarts">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Options { get; set; };
    [Parameter] public string Height { get; set; } = "380px";
    [Parameter] public string Width { get; set; } = "100%";
    [Parameter] public string AriaTitle { get; set; } = "Interactive";
    [Parameter] public string AriaSummary { get; set; };
    [Parameter] public string Extensions { get; set; };
    [Parameter] public string Maps { get; set; };
    [Parameter] public bool Loading { get; set; } = false;
    [Parameter] public bool NotMerge { get; set; } = false;
}
