@*
 * TuxMediaSlab.razor — ASP.NET Blazor Component.
 * Synchronized via Universal Component Sync Engine (scripts/sync-engine.mjs).
 *@

<section class="tux-media-slab">
    @ChildContent
</section>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Src { get; set; } = "undefined";
    [Parameter] public string Alt { get; set; };
    [Parameter] public string Eyebrow { get; set; } = "undefined";
    [Parameter] public string Title { get; set; };
    [Parameter] public string Dek { get; set; } = "undefined";
    [Parameter] public string Layout { get; set; } = overlay;
    [Parameter] public string ImageSide { get; set; } = right;
    [Parameter] public string Height { get; set; } = standard;
    [Parameter] public string Tone { get; set; } = maroon;
}
