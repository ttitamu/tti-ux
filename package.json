{
  "name": "@tti/tti-ux",
  "version": "3.0.0",
  "description": "TUX — the TTI design system: Nuxt layer, design tokens, and audit tooling. Published from code.tti.tamu.edu (Forgejo npm registry).",
  "publishConfig": {
    "registry": "https://code.tti.tamu.edu/api/packages/tti/npm/"
  },
  "repository": {
    "type": "git",
    "url": "https://code.tti.tamu.edu/tti/tti-ux.git"
  },
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "main": "./nuxt.config.ts",
  "files": [
    "app",
    "design",
    "docs",
    "kit",
    "scripts",
    "public",
    "nuxt.config.ts",
    "tsconfig.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0 --port 3030",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare || exit 0",
    "sync:aggieux": "node scripts/sync-aggieux.mjs",
    "sync:aggieux-icons": "node scripts/sync-aggieux-icons.mjs",
    "sync:fonts": "node scripts/sync-fonts.mjs",
    "gen:lucide-names": "node scripts/gen-lucide-names.mjs",
    "build:logos": "node scripts/png-to-svg-logo.mjs",
    "build:brand-logos": "node scripts/build-brand-logos.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "audit:tokens": "node scripts/audit-tokens.mjs",
    "audit:status": "node scripts/audit-status-palette.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "audit:aaa": "node scripts/audit-wcag-aaa.mjs --check",
    "build:geo": "node scripts/build-geo.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "test": "vitest run && npm run test -w @tti/tti-ux-react",
    "build:brand-env": "node scripts/extract-brand.mjs",
    "build:powerbi": "node scripts/build-powerbi-theme.mjs",
    "build:pbir": "node scripts/build-pbir-components.mjs",
    "verify:pbir": "node scripts/build-pbir-components.mjs --verify",
    "build:kit": "npm run build:tokens && npm run build:brand-env && npm run build:powerbi && npm run build:pbir && npm run build:framework",
    "build:framework": "node scripts/build-framework-targets.mjs",
    "build:elements": "node scripts/build-elements.mjs",
    "build:cem": "node scripts/gen-cem.mjs",
    "sync:engine": "node scripts/sync-engine.mjs --sync",
    "watch:sync": "node scripts/sync-engine.mjs --watch",
    "test:root": "vitest run",
    "test:all": "node scripts/test-all-suites.mjs",
    "test:quality": "node scripts/test-all-suites.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@iconify-json/lucide": "^1.2.102",
    "@nuxt/a11y": "^1.0.0-alpha.1",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/icon": "^2.0.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.6.1",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/mdc": "^0.21.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/vue-virtual": "^3.13.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-code-block-lowlight": "^3.22.4",
    "@tiptap/extension-file-handler": "^3.31.3",
    "@tiptap/extension-image": "^3.22.4",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extension-placeholder": "^3.22.4",
    "@tiptap/extension-table": "^3.22.4",
    "@tiptap/extension-table-cell": "^3.22.4",
    "@tiptap/extension-table-header": "^3.22.4",
    "@tiptap/extension-table-row": "^3.22.4",
    "@tiptap/extension-task-item": "^3.22.4",
    "@tiptap/extension-task-list": "^3.22.4",
    "@tiptap/extension-typography": "^3.22.4",
    "@tiptap/extension-underline": "^3.22.4",
    "@tiptap/extension-youtube": "^3.31.3",
    "@tiptap/html": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.22.4",
    "@tiptap/vue-3": "^3.31.3",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "echarts-liquidfill": "^3.1.0",
    "echarts-wordcloud": "^2.1.0",
    "katex": "^0.16.47",
    "lowlight": "^3.3.0",
    "mermaid": "^11.14.0",
    "nuxt": "^4.4.2",
    "postgres": "^3.4.9",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.17.7",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.32",
    "vue-router": "^5.0.0"
  },
  "lint-staged": {
    "*.{vue,ts,js,mjs}": "eslint --fix"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/open-sans": "^5.2.7",
    "@fontsource/oswald": "^5.2.8",
    "@fontsource/public-sans": "^5.2.7",
    "@fontsource/work-sans": "^5.2.8",
    "@nuxt/devtools": "^2.0.0",
    "@nuxt/test-utils": "^4.1.0",
    "@types/sanitize-html": "^2.16.1",
    "@vue/language-core": "^3.3.3",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "^4.11.3",
    "d3-geo": "^3.1.1",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "puppeteer": "^24.42.0",
    "serve-handler": "^6.1.7",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^5.7.0",
    "us-atlas": "^3.0.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.3"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "brace-expansion": "5.0.9"
  },
  "bin": {
    "tux-audit": "scripts/tux-audit.mjs"
  }
}
