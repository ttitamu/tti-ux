{
  "name": "@tti/tti-ux",
  "version": "3.4.1",
  "description": "TUX — the TTI design system: Nuxt layer, design tokens, and audit tooling. Published from code.tti.tamu.edu (Forgejo npm registry).",
  "publishConfig": {
    "registry": "https://code.tti.tamu.edu/api/packages/tti/npm/"
  },
  "repository": {
    "type": "git",
    "url": "https://code.tti.tamu.edu/tti/tti-ux.git"
  },
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "main": "./nuxt.config.ts",
  "files": [
    "app",
    "packages",
    "design",
    "docs",
    "kit",
    "scripts",
    "public",
    "nuxt.config.ts",
    "tsconfig.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0 --port 3030",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "generate": "nuxt generate",
    "prepare": "nuxt prepare || exit 0",
    "sync:aggieux": "node scripts/sync-aggieux.mjs",
    "sync:aggieux-icons": "node scripts/sync-aggieux-icons.mjs",
    "sync:fonts": "node scripts/sync-fonts.mjs",
    "gen:lucide-names": "node scripts/gen-lucide-names.mjs",
    "build:logos": "node scripts/png-to-svg-logo.mjs",
    "build:brand-logos": "node scripts/build-brand-logos.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "audit:tokens": "node scripts/audit-tokens.mjs",
    "audit:status": "node scripts/audit-status-palette.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "audit:aaa": "node scripts/audit-wcag-aaa.mjs --check",
    "db:bootstrap": "node scripts/db-bootstrap.mjs",
    "build:geo": "node scripts/build-geo.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "test": "vitest run && npm run test -w @tti/tti-ux-charts && npm run test -w @tti/tti-ux-diagrams && npm run test -w @tti/tti-ux-code && npm run test -w @tti/tti-ux-desk && npm run test -w @tti/tti-ux-content && npm run test -w @tti/tti-ux-react",
    "build:brand-env": "node scripts/extract-brand.mjs",
    "build:powerbi": "node scripts/build-powerbi-theme.mjs",
    "build:pbir": "node scripts/build-pbir-components.mjs",
    "verify:pbir": "node scripts/build-pbir-components.mjs --verify",
    "build:kit": "npm run build:tokens && npm run build:brand-env && npm run build:powerbi && npm run build:pbir && npm run build:framework",
    "build:framework": "node scripts/build-framework-targets.mjs",
    "build:elements": "node scripts/build-elements.mjs",
    "build:cem": "node scripts/gen-cem.mjs",
    "sync:engine": "node scripts/sync-engine.mjs --sync",
    "watch:sync": "node scripts/sync-engine.mjs --watch",
    "test:root": "vitest run",
    "test:all": "node scripts/test-all-suites.mjs",
    "test:quality": "node scripts/test-all-suites.mjs",
    "mcp": "node scripts/tux-mcp.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.146",
    "@nuxt/a11y": "^1.0.0-alpha.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/vue-virtual": "^3.13.47",
    "@tti/tti-ux-charts": "3.4.1",
    "@tti/tti-ux-code": "3.4.1",
    "@tti/tti-ux-content": "3.4.1",
    "@tti/tti-ux-desk": "3.4.1",
    "@tti/tti-ux-diagrams": "3.4.1",
    "nuxt": "^4.6.2",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "lint-staged": {
    "*.{vue,ts,js,mjs}": "eslint --fix"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/open-sans": "^5.2.7",
    "@fontsource/oswald": "^5.2.8",
    "@fontsource/public-sans": "^5.2.7",
    "@fontsource/work-sans": "^5.2.8",
    "@nuxt/devtools": "^3.4.4",
    "@nuxt/test-utils": "^4.3.4",
    "@types/sanitize-html": "^2.16.2",
    "@vue/language-core": "^3.3.13",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "d3-geo": "^3.1.1",
    "eslint": "^10.13.0",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "puppeteer": "^25.14.0",
    "serve-handler": "^6.1.7",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^5.7.0",
    "us-atlas": "^3.0.1",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13"
  },
  "//": [
    "overrides[@nuxtjs/mdc] only shapes THIS repo's install; npm ignores a dependency's overrides, so consumers get the ^0.23.2 range above and nothing else.",
    "overrides[katex] ensures transitive consumers (mermaid, micromark-extension-math, rehype-katex) resolve to katex ^0.19.0 (GHSA-238p-pmpm-9mq7)."
  ],
  "overrides": {
    "sharp": "^0.35.0",
    "brace-expansion": "5.0.12",
    "esbuild": "^0.28.2",
    "@nuxtjs/mdc": "$@nuxtjs/mdc",
    "katex": "$katex"
  },
  "bin": {
    "tux-audit": "scripts/tux-audit.mjs",
    "tux-mcp": "scripts/tux-mcp.mjs"
  },
  "allowScripts": {
    "puppeteer": true,
    "esbuild": false,
    "unrs-resolver": false,
    "vue-demi": false,
    "fsevents": false
  }
}
