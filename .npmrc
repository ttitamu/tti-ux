# The @tti scope lives on the Forgejo npm registry (code.tti.tamu.edu),
# not npmjs — same line consumers add (README § Consuming from another
# app). Needed here so workspace installs resolve @tti/tti-ux-react's
# peer dependency on @tti/tti-ux. Anonymous read is enabled; no token
# required to install.
@tti:registry=https://code.tti.tamu.edu/api/packages/tti/npm/
